@{
}

<link rel="stylesheet" href="~/css/datatables.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/jquery-ui.min.css" />
<link rel="stylesheet" href="~/css/site.css" />
<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">


<label>Ingrese nombre:</label>
<input type="text" id="txtNombre" />
<input type="button" id="btnBuscar" value="Buscar" class="btn btn-primary" />
<input type="button" id="btnLimpiar" value="limpiar" class="btn btn-success"/>
<button type="button" onclick="abrirModal(0)" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">Agregar</button>

<div id="tabla"></div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Editar Curso</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <tabla style="width:80%">
            <tr>
                <td width="40%">Id Periodo:</td>
                <td width="60%"><input type="text" id="txtIdCurso" class="form-control borrar obligatorio" /></td>
            </tr>
            <tr>
                <td>Ingrese nombre Curso:</td>
                <td><input type="text" id="nombre" class="form-control borrar obligatorio" /></td>
            </tr>
            <tr>
                <td>Ingrese descripción Curso:</td>
                <td><input type="text" id="txtDescripcion" class="form-control borrar obligatorio" /></td>
            </tr>
        </tabla>
      </div>
      <div class="modal-footer">
        <button onclick="Agregar()" type="button" class="btn btn-primary">Guardar</button>
        <button id="btnCancelar" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/jquery-3.7.1.min.js" asp-append-version="true"></script>
  <script src="~/js/jquery-ui.min.js" asp-append-version="true"></script>
  <script src="~/js/Curso.js" asp-append-version="true"></script>
  <script src="~/js/datatables.min.js" asp-append-version="true"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}

